#!/usr/bin/env bash
# OKF 適合の最低限の検証: 予約ファイル以外の全 .md が非空の type を持つこと。
# Why not full schema validation: 仕様は「未知のキー・未知の type を拒否するな」と
#   定めており、厳格なスキーマ検証は仕様の意図に反する。

set -uo pipefail

if [[ ! -d knowledge ]]; then
    echo "Skipped: knowledge/ がない"
    exit 0
fi

if ! command -v yq >/dev/null 2>&1; then
    echo "Skipped: yq が入っていない"
    exit 0
fi

failed=0

while IFS= read -r file; do
    case "$(basename "$file")" in
    index.md | log.md) continue ;;
    esac
    if ! yq --front-matter=extract eval '.type // ""' "$file" 2>/dev/null | grep -qv '^$'; then
        echo "$file: 非空の type が必要（OKF v0.2 §11）"
        failed=1
    fi
done < <(find knowledge -name '*.md')

exit "$failed"
